{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",

        "lessons": {
          "$day": {
            ".validate": "$day.matches(/^d[0-9]{1,5}$/) && newData.isString() && newData.val().length <= 500000"
          }
        },

        "progress": {
          "completedDays": {
            "$day": {
              ".validate": "$day.matches(/^d[0-9]{1,5}$/) && newData.val() === true"
            }
          },
          "masteredVocabIds": {
            "$id": {
              ".validate": "$id.matches(/^d[0-9]{1,5}-[0-9]{1,5}$/) && newData.val() === true"
            }
          },
          "weakVocabIds": {
            "$id": {
              ".validate": "$id.matches(/^d[0-9]{1,5}-[0-9]{1,5}$/) && newData.val() === true"
            }
          },
          "totalQuizzesTaken": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "totalCorrectAnswers": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "$other": { ".validate": false }
        },

        "memory": {
          "$id": {
            ".validate": "$id.matches(/^d[0-9]{1,5}-[0-9]{1,5}$/) && newData.hasChildren(['japanese', 'box', 'due', 'right', 'wrong', 'lastAnswered'])",
            "japanese": {
              ".validate": "newData.isString() && newData.val().length <= 300"
            },
            "box": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5"
            },
            "due": {
              ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
            },
            "right": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "wrong": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "lastAnswered": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "$other": { ".validate": false }
          }
        },

        "meta": {
          "schema": {
            ".validate": "newData.isNumber()"
          },
          "updatedAt": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "$other": { ".validate": false }
        },

        "$other": { ".validate": false }
      }
    }
  }
}
