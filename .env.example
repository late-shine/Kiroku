# Kiroku — Firebase web config. Copy this file to .env and fill in your own values.
# These values are public by design (they ship in the browser bundle); security comes from the database rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_DATABASE_URL=
